# NEURO X Mobile Environment
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
# After editing this file, restart Expo with cache clear: npx expo start -c

# Backend API.
# Android emulator: http://10.0.2.2:8000
# iOS simulator: http://localhost:8000
# Physical phone: use your computer LAN IP, for example http://192.168.2.217:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Solana / QuickNode.
# EXPO_PUBLIC_SOLANA_CLUSTER: devnet (default) or mainnet-beta (production).
# Drives MWA wallet authorization, explorer links, and UI labels.
# Keep RPC and PROGRAM_ID consistent with the cluster.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
# Paste your QuickNode HTTPS endpoint into EXPO_PUBLIC_SOLANA_RPC when ready.
EXPO_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
EXPO_PUBLIC_QUICKNODE_RPC_URL=
EXPO_PUBLIC_QUICKNODE_WS_URL=
EXPO_PUBLIC_PROGRAM_ID=E7RAJWfEmSAm3NRR4Z2YBqw27fTGazBY2eGzypmFoCnT

# ElevenLabs.
# Filled after agent creation, or paste the same value as VITE_ELEVENLABS_AGENT_ID.
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# Must match backend AGENT_WS_TOKEN when backend WebSocket guard is enabled.
EXPO_PUBLIC_AGENT_WS_TOKEN=
