{
  "expo": {
    "name": "NEURO",
    "slug": "neuro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "neuro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neuro.app"
    },
    "android": {
      "package": "com.neuro.app"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6011e964-4cad-49b0-a634-1bd1b37eda3b"
      }
    },
    "owner": "thedy09"
  }
}
