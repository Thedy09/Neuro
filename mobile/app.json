{
  "expo": {
    "name": "NEURO",
    "slug": "neuro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "neuro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neuro.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NEURO uses the microphone so you can talk to your AI wealth assistant."
      }
    },
    "android": {
      "package": "com.neuro.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow NEURO to access your microphone for voice commands."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6011e964-4cad-49b0-a634-1bd1b37eda3b"
      }
    },
    "owner": "thedy09"
  }
}
