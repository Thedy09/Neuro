{
  "expo": {
    "name": "NEURO",
    "slug": "neuro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "neuro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neuro.app"
    },
    "android": {
      "package": "com.neuro.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
