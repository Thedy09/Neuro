# NEURO X Frontend Environment
# Copy to .env and fill in values.

# Backend API used by browser features that call FastAPI.
# Required for ElevenLabs voice with private agents: the app POSTs here to get a signed WebSocket URL.
VITE_API_URL=http://localhost:8000

# Solana Devnet RPC used by the frontend.
# Put your QuickNode HTTPS endpoint here when ready.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# QuickNode reference fields for your own tracking.
# The frontend only needs VITE_SOLANA_RPC_URL.
VITE_QUICKNODE_RPC_URL=
VITE_QUICKNODE_WS_URL=

# ElevenLabs Conversational AI agent ID.
VITE_ELEVENLABS_AGENT_ID=
