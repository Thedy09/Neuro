# NEURO X Backend Environment
# Copy to backend/.env and fill API keys.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS — origines exactes (schéma + host, pas de chemin). Ajoute l’URL HTTPS du front déployé (Vercel, etc.).
# Sur Render, mets la même clé/valeur dans Environment. Inclure 5174 si Vite change de port.
# Exemple avec prod Render API + dev + futur Vercel :
# CORS_ORIGINS=["https://ton-app.vercel.app","http://localhost:5173","http://localhost:5174","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# Solana
# SOLANA_CLUSTER: devnet (default) or mainnet-beta (production).
# Keep RPC URLs and NEURO_PROGRAM_ID consistent with the cluster:
# a program deployed on devnet has a different address on mainnet.
# These RPC URLs are automatically overridden by QUICKNODE_RPC_URL / QUICKNODE_WS_URL below when filled.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
NEURO_PROGRAM_ID=E7RAJWfEmSAm3NRR4Z2YBqw27fTGazBY2eGzypmFoCnT

# QuickNode - Solana RPC, WebSocket, Streams, and webhooks
# Paste the HTTPS QuickNode endpoint in QUICKNODE_RPC_URL.
# Paste the WSS QuickNode endpoint in QUICKNODE_WS_URL.
# QUICKNODE_ENDPOINT is kept for integrations that expect one generic endpoint.
QUICKNODE_RPC_URL=
QUICKNODE_WS_URL=
QUICKNODE_ENDPOINT=
QUICKNODE_STREAM_ID=
QUICKNODE_STREAM_TOKEN=
QUICKNODE_WEBHOOK_SECRET=
QUICKNODE_WEBHOOK_SIGNATURE_HEADER=x-qn-signature

# LI.FI - Cross-chain bridge quotes
# Optional for basic UI. Required for reliable production bridge quotes.
# Get one from: https://portal.li.fi/
LIFI_API_URL=https://li.quest/v1
LIFI_API_KEY=

# Monetization — integrator fee on bridge volume (revenue model).
# Register the integrator name + fee wallet on https://portal.li.fi/.
# LIFI_FEE is a fraction of the bridged amount (0.0025 = 0.25%). Leave empty/0 to disable.
LIFI_INTEGRATOR=
LIFI_FEE=0

# ElevenLabs - Conversational AI voice agent
# Clé utilisée uniquement côté serveur (URL WebSocket signée pour le navigateur).
# Ne commite jamais de vraie clé ici : copie ce fichier vers .env et remplis les valeurs.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Agent par défaut pour /voice/signed-url si le client n'envoie pas agent_id.
ELEVENLABS_AGENT_ID=

# LLM (optionnel) — passe /chat d'un routage par mots-clés à un vrai modèle.
# Si ANTHROPIC_API_KEY est défini, Anthropic est utilisé. Sinon, n'importe quel
# endpoint compatible OpenAI via LLM_API_KEY + LLM_BASE_URL. Sans clé, l'agent
# retombe proprement sur le routage par mots-clés (aucune régression).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Agent WebSocket
# Optional local secret for /api/v1/agent/ws/{session_id}?token=...
# Generate with: openssl rand -hex 32
AGENT_WS_TOKEN=

# Monetization — freemium voice quotas (covers ElevenLabs/QuickNode costs).
# Free tier: VOICE_FREE_DAILY_REQUESTS voice calls (TTS/STT/signed-url) per
# wallet-or-IP per day. 0 = unlimited (quotas disabled, e.g. local dev).
# Production suggestion: 20.
VOICE_FREE_DAILY_REQUESTS=0
# JSON list of Pro subscriber wallets with unlimited voice.
# Example: PRO_WALLETS=["9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin"]
PRO_WALLETS=[]
